  "NewsAndTips": {
    "title": "NEWS AND TIPS",
    "description": "Here’s many things you can do in Ulaanbaatar for free and others",
    "news": [
      {
        "title": "Khuvsgul Lake",
        "description": "Often referred to as the 'Switzerland of Mongolia,' Khuvsgul Lake boasts crystal-clear waters surrounded by majestic mountains and dense forests. It is a popular destination for nature lovers and outdoor enthusiasts.",
        "image": "/image/pictures/khuvsgul.jpg"
      },
      {
        "title": "Orkhon Valley",
        "description": "A UNESCO World Heritage site, the Orkhon Valley is rich in history and culture. It features notable landmarks such as the Orkhon Waterfall, the ancient city of Kharkhorin, and the Erdene Zuu Monastery, offering a glimpse into Mongolia's past.",
        "image": "/image/pictures/orkhonii_khundii.jpg"
      },
      {
        "title": "Gobi Three Beauties",
        "description": "Located in Umnugobi Province, this stunning natural area includes breathtaking attractions like Yolyn Am, the Dungenee Rock, and the Khongoryn Els sand dunes, showcasing the unique beauty of the Gobi Desert.",
        "image": "/image/pictures/govi_gurvan_saikhan.jpg"
      },
      {
        "title": "Khorgo and Terkhiin Tsagaan Lake",
        "description": "This region in Arkhangai Province features a volcanic crater, unique geological formations, and pristine freshwater lakes, making it an ideal spot for hiking and exploring nature.",
        "image": "/image/pictures/khorgiin_togoo.jpg"
      },
      {
        "title": "Altai Tavan Bogd",
        "description": "Situated in western Mongolia, Altai Tavan Bogd is known for its majestic mountains, glacial rivers, and the rich cultural heritage of the nomadic Kazakh people, making it a stunning destination for adventure seekers.",
        "image": "/image/pictures/altai_tavan_bogd.jpg"
      },
      {
        "title": "Amarbayasgalant Monastery",
        "description": "As one of the largest and oldest monasteries in Mongolia, Amarbayasgalant is a remarkable architectural site that preserves cultural heritage and offers a serene atmosphere for visitors.",
        "image": "/image/pictures/amarbayasgalan_khiid.jpeg"
      },
      {
        "title": "Uvs Lake",
        "description": "A UNESCO-listed area, the Uvs Lake Basin features a unique landscape that combines steppes, desert, and mountainous regions, providing diverse habitats for wildlife.",
        "image": "/image/pictures/uvs_ai_sav.jpg"
      },
      {
        "title": "Khustain Nuruu",
        "description": "Home to the endangered Przewalski's horse, Khustain Nuruu is a protected area dedicated to the conservation and breeding of this rare species in its natural habitat.",
        "image": "/image/pictures/khustain_nuruu.jpg"
      },
      {
        "title": "Burkan Khaldun Mountain",
        "description": "Known as the birthplace of Genghis Khan, Burkan Khaldun Mountain is one of Mongolia's most sacred sites, rich in historical significance and natural beauty.",
        "image": "/image/pictures/burkhan_khaldun.jpg"
      },
      {
        "title": "Ogii Lake",
        "description": "Located in Arkhangai Province, Ogii Lake is a picturesque destination ideal for fishing and birdwatching, featuring clear waters and a tranquil environment.",
        "image": "/image/pictures/ugii_nuur.jpg"
      }
    ]
  },

  "FAQ": {
    "title": "FAQ",
    "questions": [
      {
        "title": "How to Use the Gerege Passport?",
        "description": "You can use your Gerege Passport by presenting it to partner organizations, scanning the QR code located on the back of the passport, or registering the phone number of the SIM card that accompanies the passport to access services."
      },
      {
        "title": "What to Do If You Lose Your Gerege Passport?",
        "description": "If you lose your Gerege Passport, you will need to purchase a new one to continue using the services."
      },
      {
        "title": "How to Activate Your Data SIM?",
        "description": "To activate your data SIM, remove it from the package, insert it into your phone, and enter the PIN code provided on the SIM card. The SIM will be activated and usable for 14 days from the activation date."
      },
      {
        "title": "Can You Extend Your Data and Days?",
        "description": "Yes, you can extend your data and usage days. You can access suitable services through the following link. <b><a href=\"https://gmobile.mn/\" target=\"_blank\">Жимобайл ХХК - Үндэсний оператор.</a></b>"
      },
      {
        "title": "Where Can You Purchase a Removable Map?",
        "description": "You can purchase a removable map at the Mongolian Costume Rental location. You can check their Facebook page for more information. <b><a href=\"https://www.facebook.com/mongolianscratchmap\" target=\"_blank\">Mongolian Costume Rental</a></b>"
      },
      {
        "title": "Where Can You Buy Hushkhan Nuts?",
        "description": "Hushkhan nuts are available for purchase at all selling points across the country. You can check local stores or visit the website: <b><a href=\"https://hushkhan.mn/\" target=\"_blank\"> hushkhan.mn – Хушхан БРЭНД</a></b> for more details."
      },
      {
        "title": "What Payment Options Are Available?",
        "description": "You can make payments using international cards or through the Korean banking app."
      },
      {
        "title": "What Should You Do If You Want to Return Your Gerege Passport for Any Reason?",
        "description": "If there are errors or duplicate transactions during payment, you can request a refund for the difference. Returns are not possible in other cases."
      },
      {
        "title": "How Long Will It Take to Receive a Refund?",
        "description": "Refunds will be processed within 7-14 days and will be credited to your account."
      },
      {
        "title": "Can You Transfer Your Gerege Passport to Someone Else?",
        "description": "The Gerege Passport is non-transferable and cannot be used by others."
      }
    ],

  "aboutUs": {
    "title": "About us",
    "description": "The <b>Gerege Tourist Passport</b> is a modern travel document and travel log inspired by the <b>Gerege</b>, a diplomatic pass used during the Mongol Empire. It serves as a symbol for promoting Mongolia’s history and culture while enhancing tourism. The Gerege Tourist Passport offers the following benefits:",
    "benefits": [
      {
        "title": "Opportunity to Explore Mongolia’s History and Culture",
        "description": "Travelers can gain a deeper understanding of Mongolia’s rich historical and cultural heritage by learning about the significance of the Gerege used during the Mongol Empire."
      },
      {
        "title": "Comprehensive and Convenient Services",
        "description": "The Gerege Passport provides all essential travel information, recommendations, locations, emergency contact numbers, tourism support centers, discounts, and promotions. It is available in English and Korean as a <b>digital solution</b> that allows online purchases, saving travelers time, money, and eliminating language barriers."
      },
      {
        "title": "Access to Discounts and Benefits",
        "description": "Holders of the Gerege Passport can enjoy exclusive discounts on hotels, tourist camps, museums, transportation, entertainment, and various other services, making their travel more affordable and enjoyable."
      },
      {
        "title": "A Memorable Travel Souvenir",
        "description": "The Gerege Passport serves as a keepsake that brings back warm travel memories every time you see it. It is not only a practical daily-use item but also a unique addition to any travel collection."
      }
    ]
  },

